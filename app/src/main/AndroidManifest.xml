<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TombolPlus">

        <!-- Layar panduan + status izin. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Empat ikon terpisah di layar utama. Masing-masing activity tidak punya
          tampilan: begitu dibuka langsung menjalankan aksi lalu menutup diri,
          jadi yang terlihat di layar selalu UI bawaan Android.
        -->

        <activity
            android:name=".shortcut.LockActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_short_lock"
            android:label="@string/shortcut_lock"
            android:taskAffinity=""
            android:theme="@style/Theme.TombolPlus.Shortcut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".shortcut.PowerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_short_power"
            android:label="@string/shortcut_power"
            android:taskAffinity=""
            android:theme="@style/Theme.TombolPlus.Shortcut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".shortcut.VolumeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_short_volume"
            android:label="@string/shortcut_volume"
            android:taskAffinity=""
            android:theme="@style/Theme.TombolPlus.Shortcut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".shortcut.ScreenshotActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_short_shot"
            android:label="@string/shortcut_screenshot"
            android:taskAffinity=""
            android:theme="@style/Theme.TombolPlus.Shortcut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Satu-satunya izin: aksesibilitas. Dipakai untuk Kunci, Power, dan
          Screenshot (global action milik Android). Volume tidak butuh izin.
        -->
        <service
            android:name=".service.TombolAccessibility"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
